{
  "permissions": {
    "defaultMode": "plan",
    "allow": ["shell:git status"],
    "ask": ["file:secrets.txt"],
    "deny": ["shell:rm"]
  },
  "shell": {
    "backend": "auto"
  },
  "memory": {
    "enabled": true,
    "roots": ["/home/public/HermesVault/Memory"],
    "files": ["MEMORY.md", "pi-memory.md", "preferences.md", "projects.md", "decisions.md", "conversation-log.md"],
    "max_chars": 12000
  },
  "catalog": {
    "refresh": {
      "command": "catalog refresh --aa",
      "pricing_source": "artificial_analysis",
      "api_key_env": "STAGEWARDEN_ARTIFICIAL_ANALYSIS_API_KEY"
    }
  }
}
